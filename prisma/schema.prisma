generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  storageUsed  BigInt   @default(0) // Storage used in bytes
  storageLimit BigInt   @default(104857600) // 100MB default limit (100 * 1024 * 1024)
  
  // Subscription fields
  planType            String   @default("FREE") // FREE or PAID
  editsThisMonth      Int      @default(0)
  editsResetDate      DateTime @default(now())
  
  // Email verification fields
  pendingEmail          String?   // New email waiting for verification
  emailVerificationToken String?  // Verification token (hashed)
  emailTokenExpiresAt   DateTime? // Token expiration time
  
  sites        Site[]
}

model Site {
  id             String    @id @default(cuid())
  userId         String
  title          String    @default("My Personal Website")
  cvUrl          String?
  cvContent      Json?
  designPlan     Json?     // Tema renkleri ve seçilen component'ler
  htmlContent    String?
  cssContent     String?
  jsContent      String?
  status         String    @default("draft")
  revisionCount  Int       @default(0)
  maxRevisions   Int       @default(5)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publishedAt    DateTime?
  cloudflareUrl  String?
  subdomain      String?   @unique
  subdomainReservationExpiresAt DateTime? // When subdomain reservation expires after unpublish
  
  // Published content snapshots - used for change detection
  publishedHtmlContent  String?
  publishedCssContent   String?
  publishedJsContent    String?
  publishedCvContent    Json?
  
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
